import { useState } from 'react';
import type { Conference } from '../types';

export function ConferenceForm({ onSave, onCancel }: { onSave: (data: Omit<Conference, 'id'>) => void, onCancel: () => void }) {
  const [formData, setFormData] = useState({
    title: '',
    description: '',
    location: '',
    startsAt: '',
    endsAt: '',
    maxParticipants: 100,
    category: 'IT'
  });

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    onSave(formData);
  };

  return (
    <div className="bg-[#161b22] p-6 rounded-lg border border-gray-700 w-full max-w-md">
      <h2 className="text-xl font-bold text-white mb-4">Nova Konferencija</h2>
      <form onSubmit={handleSubmit} className="space-y-4">
        <div>
          <label className="block text-gray-400 text-sm mb-1">Naziv</label>
          <input 
            type="text" 
            required
            className="w-full bg-[#0d1117] border border-gray-600 rounded p-2 text-white"
            onChange={(e) => setFormData({...formData, title: e.target.value})}
          />
        </div>
        <div className="grid grid-cols-2 gap-4">
          <div>
            <label className="block text-gray-400 text-sm mb-1">Početak</label>
            <input 
              type="datetime-local" 
              required
              className="w-full bg-[#0d1117] border border-gray-600 rounded p-2 text-white text-xs"
              onChange={(e) => setFormData({...formData, startDate: e.target.value})}
            />
          </div>
          <div>
            <label className="block text-gray-400 text-sm mb-1">Kraj</label>
            <input 
              type="datetime-local" 
              required
              className="w-full bg-[#0d1117] border border-gray-600 rounded p-2 text-white text-xs"
              onChange={(e) => setFormData({...formData, endsAt: e.target.value})}
            />
          </div>
        </div>
        <div>
          <label className="block text-gray-400 text-sm mb-1">Lokacija</label>
          <input 
            type="text" 
            className="w-full bg-[#0d1117] border border-gray-600 rounded p-2 text-white"
            onChange={(e) => setFormData({...formData, location: e.target.value})}
          />
        </div>
        <div className="flex justify-end gap-3 mt-6">
          <button type="button" onClick={onCancel} className="text-gray-400 hover:text-white">Odustani</button>
          <button type="submit" className="bg-yellow-500 text-black px-4 py-2 rounded font-bold">Spasi</button>
        </div>
      </form>
    </div>
  );
}