using ConferenceManagement.Application.Services;
using Microsoft.Extensions.Configuration;
using Moq;
using Moq.Protected;
using System.Net;
using Xunit;

namespace ConferenceManagement.Tests
{
    public class KeycloakServiceTests
    {
        private readonly Mock<IConfiguration> _mockConfig;
        private readonly Mock<HttpMessageHandler> _mockHttpMessageHandler;
        private readonly HttpClient _httpClient;
        private readonly KeycloakService _service;

        public KeycloakServiceTests()
        {
            _mockConfig = new Mock<IConfiguration>();
            _mockHttpMessageHandler = new Mock<HttpMessageHandler>();
            _httpClient = new HttpClient(_mockHttpMessageHandler.Object);

            // Mock config values
            _mockConfig.Setup(c => c["Keycloak:BaseUrl"]).Returns("http://keycloak:8080");
            _mockConfig.Setup(c => c["Keycloak:Realm"]).Returns("test-realm");
            _mockConfig.Setup(c => c["Keycloak:ClientId"]).Returns("test-client");
            _mockConfig.Setup(c => c["Keycloak:ClientSecret"]).Returns("test-secret");

            _service = new KeycloakService(_mockConfig.Object, _httpClient);
        }

        [Fact]
        public async Task LogoutUser_Should_Call_Keycloak_Logout_Endpoint()
        {
            // Arrange
            var rawToken = "Bearer mock-token";

            _mockHttpMessageHandler
                .Protected()
                .Setup<Task<HttpResponseMessage>>(
                    "SendAsync",
                    ItExpr.IsAny<HttpRequestMessage>(),
                    ItExpr.IsAny<CancellationToken>()
                )
                .ReturnsAsync(new HttpResponseMessage
                {
                    StatusCode = HttpStatusCode.OK,
                    Content = new StringContent("{}")
                });

            // Act
            await _service.LogoutUser(rawToken);

            // Assert
            _mockHttpMessageHandler.Protected().Verify(
                "SendAsync",
                Times.Once(),
                ItExpr.Is<HttpRequestMessage>(req =>
                    req.Method == HttpMethod.Post &&
                    req.RequestUri!.ToString().Contains("/protocol/openid-connect/logout")),
                ItExpr.IsAny<CancellationToken>()
            );
        }

        [Fact]
        public async Task LogoutUser_Should_Throw_Exception_When_Token_Is_Empty()
        {
            // Act & Assert
            await Assert.ThrowsAsync<ArgumentException>(() => _service.LogoutUser(""));
        }

        [Fact]
        public async Task LogoutUser_Should_Throw_Exception_On_Keycloak_Error()
        {
            // Arrange
            _mockHttpMessageHandler
                .Protected()
                .Setup<Task<HttpResponseMessage>>(
                    "SendAsync",
                    ItExpr.IsAny<HttpRequestMessage>(),
                    ItExpr.IsAny<CancellationToken>()
                )
                .ReturnsAsync(new HttpResponseMessage
                {
                    StatusCode = HttpStatusCode.BadRequest,
                    Content = new StringContent("Invalid token")
                });

            // Act & Assert
            var ex = await Assert.ThrowsAsync<Exception>(() => _service.LogoutUser("Bearer bad-token"));
            Assert.Contains("Keycloak logout failed", ex.Message);
        }
    }
}
